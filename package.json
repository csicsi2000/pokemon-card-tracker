		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.111.0",
		"zod": "^4.4.3"
	}
